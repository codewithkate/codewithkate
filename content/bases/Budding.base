```base
filters:
  and:
    - file.hasTag("bud")
views:
  - type: table
    name: "Budding Ideas"
    limit: 10
    groupBy:
      property: note.age
      direction: DESC
    filters:
      and:
        - 'status != "done"'
        - or:
            - "formula.ppu > 5"
            - "price > 2.1"
    order:
      - file.name
      - file.ext
      - note.age
```